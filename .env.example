# Copier en .env et compléter.
# Ce fichier est VERSIONNÉ : aucune vraie clé ne doit y figurer.

# Base de données. Lu à la fois par docker-compose et par le service.
# Port 5433 : le 5432 est occupé par une autre pile locale.
POSTGRES_USER=assurance
POSTGRES_PASSWORD=assurance
POSTGRES_DB=assurance
POSTGRES_PORT=5433

# Génération RAG. À renseigner dans .env uniquement, jamais ici.
MISTRAL_API_KEY=

# Fournisseur interchangeable : tout endpoint au format OpenAI
# chat/completions convient. Pour Ollama en local, remplacer par
# http://localhost:11434/v1 et le nom du modèle local.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODELE=mistral-small-latest