<?xml version="1.0" encoding="UTF-8"?>
<!--
  Passerelle de l'assistant Mutuelle Solstice (étape 11).

  Rôle : ce que le service Python ne doit pas porter. Session de
  conversation en base (le service IA reste sans état), contexte client
  (la formule souscrite, injectée dans la recherche), journalisation des
  échanges, dégradation propre en 503 quand le service IA est indisponible.

  Java 17, Spring Boot 3.3.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>

  <groupId>com.solstice</groupId>
  <artifactId>gateway</artifactId>
  <version>0.11.0</version>
  <name>solstice-gateway</name>
  <description>Passerelle session, contexte client et journalisation
    devant le service IA FastAPI</description>

  <properties>
    <java.version>17</java.version>
    <!-- Le poste compile en Cp1252 par défaut (voir mvn -version) :
         sans ces lignes, les chaînes et commentaires accentués des
         sources seraient lus dans le mauvais encodage. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <!-- MVC classique pour exposer /api/** au front Angular. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- WebClient pour appeler FastAPI : c'est lui qui porte les délais
         d'attente explicites exigés par le cadrage. Le serveur reste
         MVC ; on ne prend de webflux que le client. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- Sessions et clients fictifs. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Base embarquée en mémoire : les sessions et les clients de
         démonstration sont des données jetables. Les mettre dans le
         Postgres de l'index mélangerait le décor avec le système
         mesuré, et H2 dispense quiconque clone le dépôt de toute
         configuration. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Validation des corps de requête (@Valid, @NotBlank). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>