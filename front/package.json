{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "copier:metriques": "node -e \"const f=require('fs');const s='../docs/metrics.md';const d='public/metrics.md';if(f.existsSync(s)){f.copyFileSync(s,d);console.log('[metriques] '+s+' copie vers '+d);}else{console.warn('[metriques] ATTENTION: '+s+' absent, la page metriques le dira. Lancer python ml/build_metrics.py');}\"",
    "prestart": "npm run copier:metriques",
    "prebuild": "npm run copier:metriques",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.1",
    "@angular/cli": "^22.1.1",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}